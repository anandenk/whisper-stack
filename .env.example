# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit secrets.
#
# load_dotenv(override=True) at the top of server/config.py means values here
# overwrite any same-named Windows/shell env var, so an empty GOOGLE_API_KEY
# in your shell environment can't shadow the real key.

# ============================================================================
# LLM — Gemini 2.5 Flash via Google AI Studio
# ============================================================================

# Get a key at https://aistudio.google.com -> "Get API key".
GOOGLE_API_KEY=

# Optional: pin a specific Gemini model. Defaults to the alias `gemini-2.5-flash`
# which Google updates as new dated revisions ship.
# GEMINI_MODEL=gemini-2.5-flash

# ============================================================================
# STT — faster-whisper (local GPU)
# ============================================================================

# WHISPER_MODEL=large-v3-turbo
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE=float16

# Pin STT language ('en', 'es', etc.). Leave empty to let Whisper auto-detect
# (which can misfire on short or noisy utterances and lock onto wrong languages).
# WHISPER_LANGUAGE=en

# ============================================================================
# TTS — Piper (local)
# ============================================================================

# Any voice from https://github.com/rhasspy/piper/blob/master/VOICES.md — drop
# the .onnx + .json files under models/piper/ and set the name here.
# PIPER_VOICE=en_US-amy-medium

# Speech rate. Lower = faster. Default 0.85 is ~15% faster than 1.0 and still
# natural; 0.75 is noticeably snappy, 0.7 starts to sound rushed.
# PIPER_LENGTH_SCALE=0.85

# Optional substring (or integer index) matched against output device names.
# When set, /speak and /converse playback target this device — useful so a
# Bluetooth headset plugging in doesn't reroute the assistant's voice.
# Avoid Hands-Free Bluetooth profiles ('Headset (...)') — they run at 8 kHz
# and sound terrible. Use A2DP/stereo or a wired/USB device.
# Run `python -c "import sounddevice as sd; print(sd.query_devices())"` to enumerate.
# TTS_OUTPUT_DEVICE=

# ============================================================================
# HTTP server
# ============================================================================

# HOST=127.0.0.1   # Set to 0.0.0.0 for ESP-32 / LAN access.
# PORT=5000
# WARMUP=1         # Set 0 to skip the boot warmup (whisper PTX JIT, etc.).

# Optional shared-secret auth on /converse, /converse/stream, /chat,
# /transcribe, /speak, /listen. GET / and /health stay public.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty for LAN-only use.
# API_KEY=

# Voice-mode reply length cap (tokens) — keeps a chatty LLM from generating
# 30 s of audio per turn.
# CONVERSE_MAX_TOKENS=96

# Safety cap on tool-call iterations per request (prevents runaway billing
# from a model that loops on tool_use).
# TOOL_MAX_ROUNDS=5

# ============================================================================
# Sessions (multi-turn memory — see notes/sessions-plan.md)
# ============================================================================

# Where session files live (REPO_ROOT-relative unless absolute).
# SESSION_DIR=sessions
# Idle gap before a new session file rolls over for the same session_id.
# SESSION_IDLE_TIMEOUT_MIN=10
# Max recent turns sent to the LLM as `history` per request.
# SESSION_WINDOW_TURNS=30
# Optional TTL — sessions older than N days are pruned at server boot.
# Unset/empty = never prune.
# SESSION_TTL_DAYS=

# Voice system prompt — overrides the default. The default tells Gemini to
# reply in plain conversational prose (no markdown, no LaTeX) and to keep
# replies to 1-2 sentences so the TTS output stays short.
# VOICE_SYSTEM_PROMPT=

# ============================================================================
# Wake-word client (tests/jarvis.py only — server doesn't read these)
# ============================================================================

# WAKEWORD_MODEL=hey_jarvis
# WAKEWORD_THRESHOLD=0.5
# WAKEWORD_CHIME=samples/chime.wav
# WAKEWORD_CONVERSATION_TIMEOUT_S=30

# ============================================================================
# Diagnostics
# ============================================================================

# When "1", every /converse upload is also saved as samples/_loopback_turn_*.wav
# (post-normalize) so an offline analyzer can replay every turn. Only enable
# while running tools/loopback_test.py.
# LOOPBACK_KEEP_PER_TURN=0
