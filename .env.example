# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit secrets.
#
# Tags: [both] = used by every mode, [local] = MODE=local only,
# [cloud] = MODE=cloud only. The unused block is ignored at runtime — one
# .env covers both modes.

# ============================================================================
# [both]
# ============================================================================

# Selects the backend set instantiated at process boot. One process serves
# one mode — no runtime switching. Validated at import.
MODE=local

# Anthropic — local-mode complex route (Sonnet) + cloud-mode complex route
# (Sonnet) AND cloud-mode simple route (Haiku, see ANTHROPIC_HAIKU_MODEL).
ANTHROPIC_API_KEY=sk-ant-...

# Optional shared-secret auth on /converse, /chat, /transcribe, /speak.
# Leave empty for LAN-only use; required when MODE=cloud and the server is
# exposed publicly. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=

# Voice-prompt + reply length budget (apply in both modes).
# CONVERSE_MAX_TOKENS=96
# Router margin: simple wins only when it beats complex by this much. May
# need re-tuning per mode (different embedders → different score scales);
# Phase 8 documents per-mode recommended values.
# ROUTER_MARGIN_S=0.05

# ============================================================================
# [local] — workstation with NVIDIA GPU + Ollama
# ============================================================================

# faster-whisper STT
# WHISPER_MODEL=large-v3-turbo
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE=float16

# Ollama — simple-route LLM + (in local mode) the router embedder.
# Use 127.0.0.1, not localhost — DNS/IPv6 fallback adds ~2s per request on Windows.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b-instruct-q5_K_M
# EMBED_MODEL=nomic-embed-text

# Piper TTS
# PIPER_VOICE=en_US-amy-medium
# Speech rate. Lower = faster. Default 0.85 (~15% faster than 1.0); 0.75 is
# noticeably snappy, 0.7 starts to sound rushed.
# PIPER_LENGTH_SCALE=0.85
# Optional substring matched against output device names (avoid Hands-Free
# Bluetooth profiles — they run at 8 kHz and sound terrible).
# TTS_OUTPUT_DEVICE=

# ============================================================================
# [cloud] — VPS deploy (Phase 9). Wire keys when the corresponding phase lands.
# ============================================================================

# Phase 5 — Deepgram nova-3 STT
# DEEPGRAM_API_KEY=

# Phase 7 — OpenAI tts-1 (PCM)
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy

# Phase 6 — cloud-mode simple-route LLM (defaults to claude-haiku-4-5; Phase 6
# verifies the alias and may pin to the dated form e.g. claude-haiku-4-5-20251001).
# ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
