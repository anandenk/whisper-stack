# Read by backend/app.py only. Shell environment values take precedence.
# Enter the key locally in backend/.env; restart the server after changes.
ELEVENLABS_API_KEY=
# GET /voices lists the first 100 available voice names and IDs.
ELEVENLABS_VOICE_ID=
# Initial test defaults; access and actual quality/latency need live verification.
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2

# Configure locally with: backend/.venv/bin/python -m backend.configure_anthropic
# Never paste this key in chat. Restart after configuring it.
ANTHROPIC_API_KEY=
