menu "Whisper Stack Device"

    config WS_WIFI_SSID
        string "WiFi SSID"
        default "changeme"
        help
            SSID of the 2.4GHz network the device joins. ESP-WROOM-32
            does not support 5GHz.

    choice WS_WIFI_AUTH_MODE
        prompt "WiFi auth mode"
        default WS_WIFI_AUTH_PSK
        help
            Pick PSK for home WiFi or phone hotspot. Pick WPA2-Enterprise
            for 802.1X networks like eduroam or university dorm WiFi
            (username + password, PEAP-MSCHAPv2). EAP-TLS (client cert)
            is not supported.

        config WS_WIFI_AUTH_PSK
            bool "WPA2-PSK (home / phone hotspot)"

        config WS_WIFI_AUTH_WPA2_ENTERPRISE
            bool "WPA2-Enterprise / 802.1X (eduroam, dorm WiFi)"
    endchoice

    config WS_WIFI_PASS
        string "WiFi password (PSK only)"
        depends on WS_WIFI_AUTH_PSK
        default "changeme"

    config WS_WIFI_EAP_IDENTITY
        string "EAP outer identity (optional)"
        depends on WS_WIFI_AUTH_WPA2_ENTERPRISE
        default ""
        help
            "Anonymous" identity sent in the clear during the outer TLS
            handshake. Many universities use anonymous@realm here.
            Leave empty to send the inner username as the outer identity
            too — works on most networks.

    config WS_WIFI_EAP_USERNAME
        string "EAP username (inner identity)"
        depends on WS_WIFI_AUTH_WPA2_ENTERPRISE
        default ""
        help
            Real username, typically user@realm. Sent inside the encrypted
            PEAP tunnel.

    config WS_WIFI_EAP_PASSWORD
        string "EAP password"
        depends on WS_WIFI_AUTH_WPA2_ENTERPRISE
        default ""

    config WS_SERVER_HOST
        string "whisper-stack server LAN IP"
        default "192.168.1.100"
        help
            IPv4 address of the workstation running `python -m server.app`.
            mDNS resolution is deferred to a later milestone; hardcoded
            for M1.

    config WS_SERVER_PORT
        int "whisper-stack server port"
        default 5000

    config WS_API_KEY
        string "X-API-Key value"
        default ""
        help
            Must match server's API_KEY in .env. Empty disables auth
            (LAN-only mode).

    config WS_SESSION_ID
        string "Session ID for multi-turn conversation memory"
        default "esp32"
        help
            Passed as ?session_id=<value> on /converse. The server
            keeps a per-session conversation history (markdown file
            on disk, idle-bounded TTL — see notes/sessions-plan.md).
            Default "esp32" enables follow-up questions like
            "what about tomorrow?" to remember the previous turn.
            Set to empty to opt out (every turn stateless).
            Must match [A-Za-z0-9_-]{1,64}.

    choice FACE_RENDERER
        prompt "Face renderer for the FACE OLED (I²C bus 1, addr 0x3C)"
        default FACE_RENDERER_ROBO_EYES
        help
            Which renderer drives the second (face) SSD1306 OLED.
            Both renderers stay in tree; the unused one is gated out
            at compile time. The status panel (main OLED) is
            unaffected by this choice. See notes/face-renderer.md
            for the state -> mood mapping and the planned gaze
            coupling.

        config FACE_RENDERER_CAT_FACE
            bool "Cat-face (legacy pre-rendered framebuffers)"
            help
                The original cat-face renderer. Plays per-state
                animation tables from firmware/main/cat_face.h
                (auto-generated by tests/oled_dump_c.py from the
                Python design tool tests/oled_animate.py). On-device
                cost is one memcpy + I2C flush per frame. Pick this
                if you want to revert to the pre-v3 look, or to
                isolate a regression that landed alongside the
                RoboEyes integration.

        config FACE_RENDERER_ROBO_EYES
            bool "FluxGarage RoboEyes port (GPL-3.0)"
            help
                Port of FluxGarage RoboEyes V1.1.1 by Dennis
                Hoelscher (github.com/FluxGarage/RoboEyes) — two
                animated rounded-rectangle eyes with autoblinker,
                idle-mode random gaze wander, and four moods
                (DEFAULT / TIRED / ANGRY / HAPPY). Drawing logic
                runs on-device from a small in-memory framebuffer;
                no Arduino / Adafruit_GFX dependency. The component
                lives at firmware/components/robo_eyes/.

                Picking this option makes the firmware binary a
                derivative work of GPL-3.0 code — see the LICENSE
                file at the repo root.

    endchoice

    config GAZE_COUPLING_DEMO
        bool "Gaze coupling (head follows eyes via SG90)"
        default n
        help
            v3 prototype validation. When set, the firmware spawns a
            small follower task that:
              * Initializes the SG90 servo on GPIO 18.
              * Polls robo_eyes_get_eye_x_angle() every 50 ms.
              * Maps the eye's current horizontal angle to a narrower
                servo range and issues servo_move_to(target, 800 ms)
                whenever the new target differs from the last commanded
                by more than 5°.

            The face renderer is NOT driven externally — the RoboEyes
            library runs in its stock autonomous mode (autoblinker on,
            idle wander on both axes) and the head simply follows where
            the eyes have already decided to look. Matches the natural
            sequence in real character motion: eyes orient first within
            milliseconds, then the head follows over a longer arc.

            Wiring (per notes/servo-motion-language.md):
              SG90 brown  → GND
              SG90 red    → VIN (5V from USB — NOT 3V3)
              SG90 yellow → GPIO 18

            Off by default — only relevant during v3 bring-up. When
            unset, no servo init, no follower task. Recommended
            companion setting: CONFIG_VOICE_ENABLED=n so the state
            machine doesn't try to drive the face into LISTENING /
            SPEAKING moods.

    config VOICE_ENABLED
        bool "Enable voice pipeline (mic + wake word + /converse)"
        default y
        help
            Master switch for the entire voice path. When set, the
            firmware brings up the I²S microphone, the wake-word
            /listen stream, and the /converse round-trip helpers as
            usual. When unset, all of those are gated out at compile
            time: no mic init, no listen_stream task, no HTTP audio
            streaming. WiFi, OLED (both panels), cat-face animation,
            gesture, IR, and the BOOT button stay live.

            Use n for v3 prototype bring-up where you want to iterate
            on display + servo motion without the wake-word stream
            hammering the CPU and network. See notes/build-modes.md
            for the full menuconfig flow.

    config WS_CONTINUOUS_MODE_ENABLED
        bool "Continuous-mode follow-ups after wake (M5 behavior)"
        depends on VOICE_ENABLED
        default n
        help
            When set, the device stays in LISTENING for
            WS_CONVERSATION_TIMEOUT_MS (30 s) after each reply so the
            user can ask a follow-up without re-saying "Hey Kira."
            When unset, every turn requires a fresh wake — same shape
            as Alexa / Siri default behavior. Most assistants make
            this opt-in for a reason: in a shared room, continuous
            mode picks up every nearby voice as input, costing money
            (Gemini credits) and producing weird replies. Without
            speaker recognition (we have none), the only audio filter
            we have is "is this speech?" — and other people ARE
            speech, so vadnet1 correctly classifies them as such.

            Default n shipped in the post-M6 audit. The M5 code path
            stays compiled-conditional in main.c
            (do_round_trip_streaming_with_preroll's while loop) so
            flipping this back on later is one menuconfig toggle —
            no code change.

    config WAKE_INPUT_GAIN_X10
        int "Pre-AFE input gain (×10, so 10 = 1.0×)"
        depends on VOICE_ENABLED
        default 10
        range 1 200
        help
            Optional pre-AFE gain applied per int16 mic sample with
            saturation clipping, in tenths (10 = 1.0×, 60 = 6.0×, etc).
            Default 1.0× (no pre-amp) because AFE-SR runs AGC before
            WakeNet — pre-amping fights AGC by lifting silence into
            its "compress" envelope, which lowers gain on real speech
            and hurts recall.

            Only raise above 10 if recall is poor in M2-d smoke
            testing AND the silence-amplification concern proves
            negligible in practice. The wakeword.py server-side
            LISTEN_GAIN=6× was needed because openWakeWord has no
            AGC; that justification does not transfer here.

    config WAKE_VAD_MIN_SPEECH_MS
        int "AFE VAD: minimum sustained speech duration (ms)"
        depends on VOICE_ENABLED
        default 128
        range 32 500
        help
            v2-M6: AFE's VAD requires speech-like frames to be
            sustained for this many milliseconds before flipping
            to AFE_VAD_SPEECH. Default 128 ms — below the typical
            150-250 ms duration of single-syllable English words
            ("yes" / "no" / "stop"), so real speech crosses it,
            and well above typing clicks (5-30 ms) which never do.

            Drop to 80 ms if M6-d smoke shows real speech being
            clipped at start. Raise toward 250 ms if rapid speech
            isn't aggregating well.

    menu "M7 — HC-SR04 ultrasonic gesture wake"

        config WAKE_GESTURE_ENABLED
            bool "Enable HC-SR04 wave-to-wake"
            default n
            help
                When set, the firmware spawns a polling task that pulses
                the trigger pin every WAKE_GESTURE_POLL_INTERVAL_MS,
                times the echo, and fires a wake event on a "wave"
                gesture (down-up-down threshold crossing within
                WAKE_GESTURE_WINDOW_MS). Off by default — existing
                builds without an HC-SR04 wired keep their pre-M7
                behavior.

        config WAKE_GESTURE_TRIG_GPIO
            int "HC-SR04 trigger GPIO"
            depends on WAKE_GESTURE_ENABLED
            default 32
            help
                Output pin pulsed for ≥10 µs to start a measurement.
                Pick from free GPIOs 5/18/19/23/32. Default 32 because
                it leaves the input-only 34-39 range available for the
                echo line.

        config WAKE_GESTURE_ECHO_GPIO
            int "HC-SR04 echo GPIO"
            depends on WAKE_GESTURE_ENABLED
            default 35
            help
                Input pin reading the echo pulse. Echo line is 5V
                logic — REQUIRES a voltage divider (1kΩ + 2kΩ to GND)
                between the sensor and the ESP32 input. Pick from
                input-capable GPIOs (any digital pin, including the
                input-only 34-39 range — 35 is the default).

        config WAKE_GESTURE_THRESHOLD_CM
            int "Wave detection distance threshold (cm)"
            depends on WAKE_GESTURE_ENABLED
            default 15
            help
                A reading at or below this distance counts as "below"
                in the down-up-down state machine. 15 cm is roughly
                "hand passing right in front of the device".

        config WAKE_GESTURE_WINDOW_MS
            int "Wave detection window (ms)"
            depends on WAKE_GESTURE_ENABLED
            default 1500
            help
                Maximum time between the first and second below-
                threshold crossing for a wave to register. Filters
                static obstacles (one cross then stays put — never
                fires) while accepting real waves.

        config WAKE_GESTURE_POLL_INTERVAL_MS
            int "HC-SR04 poll interval (ms)"
            depends on WAKE_GESTURE_ENABLED
            default 50
            help
                How often to pulse trigger and measure. 50 ms gives
                ~20 samples per second — enough resolution to catch
                a fast wave without saturating the CPU.

    endmenu

    menu "M8 — IR remote (mute / snooze / cancel)"

        config IR_ENABLED
            bool "Enable NEC IR remote receiver"
            default n
            help
                When set, the firmware brings up an RMT-RX channel on
                IR_GPIO_PIN, decodes NEC frames, and dispatches the
                three configured codes into the mute / snooze / cancel
                handlers. Off by default — existing builds without an
                IR receiver wired keep their pre-M8 behavior.

        config IR_GPIO_PIN
            int "IR receiver signal GPIO"
            depends on IR_ENABLED
            default 19
            help
                Pin connected to the IR receiver module's signal output.
                The module demodulates the 38 kHz carrier internally and
                outputs an active-low envelope — directly readable by
                the ESP32 with no level shifting (it idles HIGH at VCC,
                which is 3.3V).

        config IR_MUTE_BUTTON_CODE
            hex "NEC code for mute toggle"
            depends on IR_ENABLED
            default 0x0
            help
                Full 32-bit NEC frame for the mute button. Default 0
                disables — a value of 0 in the firmware means "code
                not yet identified". First-time setup: leave at 0,
                flash, point remote at receiver, press the button you
                want to assign, read the "IR rx: 0x..." line from the
                serial monitor, set that hex value here, reflash.

        config IR_SNOOZE_BUTTON_CODE
            hex "NEC code for snooze"
            depends on IR_ENABLED
            default 0x0
            help
                Full 32-bit NEC frame for the snooze button. See
                IR_MUTE_BUTTON_CODE for the mapping-pass procedure.

        config IR_CANCEL_BUTTON_CODE
            hex "NEC code for mid-turn cancel"
            depends on IR_ENABLED
            default 0x0
            help
                Full 32-bit NEC frame for the cancel button. See
                IR_MUTE_BUTTON_CODE for the mapping-pass procedure.

        config IR_SNOOZE_DURATION_MIN
            int "Snooze duration (minutes)"
            depends on IR_ENABLED
            default 30
            help
                When the snooze button fires, both wake sources are
                paused for this many minutes, then auto-resume.
                Pressing snooze again while already snoozed resets
                the timer to a fresh duration.

    endmenu

endmenu
