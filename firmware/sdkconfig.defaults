# sdkconfig.defaults — committed defaults; user copies this to ./sdkconfig
# and edits the local copy with real WiFi creds + server addr (Step 7).

# --- Chip target -----------------------------------------------------------
# v2: ESP32-S3-DevKitC-1 with ESP32-S3-WROOM-1-N8R8 (8 MB flash, 8 MB octal
# PSRAM). The pre-v2 WROOM-32 (LX6, no PSRAM) build is preserved at git tag
# `pre-esp32-s3-port`; checkout that tag if you ever need to rebuild for the
# original DOIT V1 board. GPIOs 22-25 (don't exist on S3) and 26-37 (claimed
# by SPI flash + octal PSRAM) are unavailable — see pin map in
# notes/esp32-firmware-plan.md.
CONFIG_IDF_TARGET="esp32s3"

# --- PSRAM (N8R8 = 8 MB octal) --------------------------------------------
# Required for esp-skainet on-device wake word (deferred milestone). Octal
# PSRAM claims GPIOs 33-37 in addition to the flash pins 26-32 — keep all
# of 26-37 off the user pin map.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# --- Console output -------------------------------------------------------
# Bring-up uses the DevKitC-1's UART port (CP210x/CH340 bridge on the left
# USB-C). The native USB-CDC port on the right is unused for now — switch
# to it later by setting CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y if a
# single-cable setup is preferred.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# --- Partition table -------------------------------------------------------
# v2-M2 needs a custom CSV to add a `model` partition for esp-sr's
# srmodels.bin (WakeNet wake-word models — esp-sr does NOT auto-inject
# the partition, see its CMakeLists.txt's CONFIG_PARTITION_TABLE_CUSTOM
# branch). Built-in `partitions_two_ota.csv` lacked the model entry, so
# we switched to `partitions_two_ota_model.csv`. Same OTA layout shape,
# bumped app partitions 1 MB → 1.5 MB to absorb esp-sr's ~500 KB of
# static-library code growth.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_two_ota_model.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# --- esp-sr wake-word selection -------------------------------------------
# v2-M2: enable only the "Hey Kira" wake-word model (two-word phrase
# gives lower FP rate than the single-word options in conversational
# backgrounds). Other stock models stay disabled to keep srmodels.bin
# small. (The plan originally called for wn9_jarvis_tts; we switched
# to Hey Kira on 2026-05-12 — see notes/esp32-v2-plan.md for the
# trade-off discussion and FP-rate fallback options.)
CONFIG_SR_WN_WN9_HEYKIRA_TTS3=y
# Use WebRTC noise suppression + VAD for the AFE pipeline; the deep-learning
# variants (nsnet2 / vadnet1) are heavier and not needed until we tune.
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y

# --- v2-M2 on-device wake-word ------------------------------------------
# listen_stream.c (the v1 server-side /listen client) was deleted in
# v2-M2-c — wake.c (esp-sr WakeNet) is the only wake path. The
# /listen route on the server stays in tree for web client +
# tests/jarvis.py, just no longer used by the firmware.
CONFIG_WAKE_INPUT_GAIN_X10=10

# --- Compiler / log level --------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- App config (Kconfig.projbuild) ---------------------------------------
# Placeholders — replaced in the local sdkconfig at Step 7.
CONFIG_WS_WIFI_SSID="changeme"
# Auth mode: default to PSK (home / phone hotspot). Flip to enterprise
# in `idf.py menuconfig` (or by editing the local sdkconfig) for dorm /
# eduroam-style 802.1X networks.
CONFIG_WS_WIFI_AUTH_PSK=y
# CONFIG_WS_WIFI_AUTH_WPA2_ENTERPRISE is not set
CONFIG_WS_WIFI_PASS="changeme"
CONFIG_WS_WIFI_EAP_IDENTITY=""
CONFIG_WS_WIFI_EAP_USERNAME=""
CONFIG_WS_WIFI_EAP_PASSWORD=""
CONFIG_WS_SERVER_HOST="192.168.1.100"
CONFIG_WS_SERVER_PORT=5000
CONFIG_WS_API_KEY=""
CONFIG_WS_SESSION_ID="esp32"

# --- LWIP / TCP buffers ---------------------------------------------------
# Default TCP send buffer (5760 B, ~4 packets in flight per RTT) caps
# throughput at ~28 KB/s at RTT=200 ms — below the 32 KB/s mic stream
# rate. On contended 2.4 GHz links retransmits stall the producer and
# audio frames get recycled. 64 KB absorbs ~10× more in flight before
# backpressuring. See CLAUDE.md gotcha #9.
# The CONFIG_TCP_*_DEFAULT names were renamed to CONFIG_LWIP_TCP_*_DEFAULT
# in IDF 5.x — keeping only the new names to avoid reconfigure warnings.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768

# --- M7 (HC-SR04 wave-to-wake) and M8 (IR remote) -------------------------
# Both default OFF — opt in via menuconfig. Codes default 0; firmware logs
# received frames so the user can fill in the real values for their remote.
# CONFIG_WAKE_GESTURE_ENABLED is not set
# CONFIG_IR_ENABLED is not set
